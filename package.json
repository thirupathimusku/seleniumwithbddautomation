{
  "name": "orangehrm-automation",
  "version": "1.0.0",
  "description": "OrangeHRM Test Automation with Playwright, Cucumber BDD, TypeScript & Allure",
  "scripts": {
    "test": "cucumber-js",
    "test:e2e": "cucumber-js --profile e2e",
    "test:api": "cucumber-js --profile api",
    "test:all": "cucumber-js",
    "test:headed": "cucumber-js --parallel 1",
    "test:chrome": "BROWSER=chromium cucumber-js",
    "test:firefox": "BROWSER=firefox cucumber-js",
    "test:edge": "BROWSER=msedge cucumber-js",
    "test:parallel": "cucumber-js --parallel 3",
    "test:tags": "cucumber-js --tags",
    "test:api:auth": "cucumber-js --profile api --tags '@auth-api'",
    "test:api:users": "cucumber-js --profile api --tags '@users-api'",
    "report": "allure generate ./allure-results --clean -o ./allure-report && allure open ./allure-report",
    "report:generate": "allure generate ./allure-results --clean -o ./allure-report",
    "report:open": "allure open ./allure-report",
    "clean": "rimraf allure-results allure-report test-results screenshots logs",
    "lint": "eslint tests/**/*.ts",
    "format": "prettier --write tests/**/*.ts"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "typescript",
    "allure",
    "test-automation"
  ],
  "author": "QA Team",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^10.0.1",
    "@playwright/test": "^1.40.1",
    "@types/node": "^20.10.5",
    "allure-commandline": "^2.25.0",
    "allure-cucumberjs": "^2.15.0",
    "dotenv": "^16.3.1",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "winston": "^3.11.0"
  }
}
